# Copy to .env and point it at a reachable NYBB server.
#
# There is deliberately no default in the code. A phone running Expo Go cannot
# reach the development machine's localhost, so a built-in fallback would be a
# URL that works in a simulator and fails silently on every real device.
#
# Use the LAN address your dev server prints, on the same wifi as the phone:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
#
# EXPO_PUBLIC_ variables are inlined into the bundle at build time, so nothing
# secret may ever be put here. The app holds no provider keys of any kind.
EXPO_PUBLIC_API_URL=
